# Обязательно заполните все четыре значения.
WORLD_URL=http://localhost:3002
DB_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Необязательно: название, адрес прослушивания и внешний порт.
WORLD_NAME=3dtalks
# Локально — 127.0.0.1, для доступа по IP сервера — 0.0.0.0.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3002
# ADMIN_PASSWORD: от 12 символов до 72 байт UTF-8; только для первого администратора.
# Пароли с $ или # заключайте в одинарные кавычки.
# Секреты авторизации генерируются автоматически и сохраняются в Docker-томе.

# Экспериментальные этапы ROOM_MEDIA_V2_PLAN.md. На рабочем сервере пока выключены.
ROOM_VIDEO_UPLOAD_ENABLED=false
ROOM_VIDEO_PLAYBACK_ENABLED=false
ROOM_PPTX_IMPORT_ENABLED=false

# Live audio requires compose.audio.yaml, private LiveKit config and Nginx admission gate.
ROOM_REALTIME_AUDIO_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
